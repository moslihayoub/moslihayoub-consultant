rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Collection des leads générés par le Chatbot M84
    match /leads/{leadId} {
      // Autorise la création de leads par les visiteurs (publiques ou récapitulés par le chatbot)
      allow create: if true;
      
      // Autorise la lecture, modification et suppression pour la gestion du CRM
      allow read, update, delete: if true;
    }
    
    // Collection des données d'analytics et de visites
    match /analytics/{docId} {
      allow read, write: if true;
    }
    
    // Configuration de l'agent (System Prompt)
    match /config/{docId} {
      allow read, write: if true;
    }
    
    // Par défaut, bloque tout le reste pour la sécurité
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
